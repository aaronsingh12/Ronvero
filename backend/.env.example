# Server
NODE_ENV=production
PORT=5000
# Comma-separated allowed storefront origins (include your Netlify URL).
CLIENT_URL=http://localhost:5173,https://your-site.netlify.app

# Database: use a managed MongoDB Atlas URI in production.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Generate two separate random secrets (at least 32 bytes each).
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RONVERO <no-reply@ronvero.com>"
