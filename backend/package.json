{
  "name": "ronvero-backend",
  "version": "1.0.0",
  "description": "RONVERO e-commerce API — Node.js, Express, MongoDB",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js --import",
    "seed:admin": "node seed/createDemoAdmin.js",
    "seed:sample-product": "node seed/createSampleProduct.js",
    "seed:demo-content": "node seed/createDemoContent.js",
    "seed:destroy": "node seed/seed.js --destroy"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "slugify": "^1.6.6",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
